<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Adaptive-icon background. Pure white rather than the brand accent: the
        launcher masks the icon to whatever shape the device theme uses, and a
        coloured background turns every themed icon into a solid blob. White
        keeps the mark legible in both light and dark launchers, with the accent
        carried by the artwork itself.

        Declared here rather than in a colors.xml: this file already existed, and
        adding a second definition of the same resource makes the Android
        resource merger fail with "Duplicate resources" at package time.
    -->
    <color name="ic_launcher_background">#FFFFFF</color>
</resources>