<?xml version="1.0" encoding="utf-8"?>
<!-- Metadata for the countdown + action widget. resizeMode is horizontal|vertical
     so the widget adapts to the launcher's chosen size, and widgetCategory is
     home_screen because that is where a wellness reminder belongs. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:minResizeWidth="140dp"
    android:minResizeHeight="80dp"
    android:updatePeriodMillis="900000"
    android:initialLayout="@layout/csph_standup_widget"
    android:previewLayout="@layout/csph_standup_widget"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/csph_widget_description" />
