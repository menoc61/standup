<?xml version="1.0" encoding="utf-8"?>
<!--
  Pill behind the action button.

  Kept white and neutral: RemoteViews cannot apply a runtime colour to a rounded
  shape, and a filled accent pill with a label on top would need a hardcoded
  contrast pairing per accent. A white pill with the accent as the label colour
  is the one combination that is always legible and always follows the user's
  choice.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFFFFFFF" />
    <stroke
        android:width="1dp"
        android:color="#FFE4E5E0" />
    <corners android:radius="20dp" />
</shape>
