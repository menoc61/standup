<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  The App Group is the only channel between the app and the widget. Both
	  targets must declare the same value, and the identifier must start with the
	  team's prefix so it can be registered in the developer portal.
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.healthwellness.standupApp</string>
	</array>
</dict>
</plist>
