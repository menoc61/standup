<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  The App Group is the only channel between the app and its widget. The
	  value must match ios/StandUpWidget/StandUpWidget.entitlements exactly; if
	  the two drift, the widget renders empty with no build or runtime error.
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.healthwellness.standupApp</string>
	</array>
</dict>
</plist>
